# Copy this file to .env.local and fill in what you need.
# Everything here is optional — the app runs without any of it.

# ---------------------------------------------------------------------------
# Sessions
# Required in production; falls back to a development string locally.
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Google sign-in
# From the Google Cloud Console. Redirect URI must be exactly:
#   http://localhost:3000/api/auth/google/callback
# Full walkthrough in docs/AUTH.md
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# AI trip planning
# Without this, /api/plan answers with the built-in offline planner.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional: override the model used by app/api/plan/route.ts
# WANDERLY_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# AI travel assistant chat
# Without this, /api/chat answers with the built-in offline responder.
# Get a key at https://console.groq.com
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# Optional: override the model used by app/api/chat/route.ts
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: where the JSON user store lives (default: ./.data)
# WANDERLY_DATA_DIR=
